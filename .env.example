PORT=5000
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the model (default claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Optional (Phase 9 RAG): Voyage AI key for semantic vector search.
# Without it, RAG uses keyword search. Get a key at https://www.voyageai.com
VOYAGE_API_KEY=

# Optional (Phase 10): GitHub token raises the GitHub API rate limit for repo reviews.
GITHUB_TOKEN=

# Phase 11: progress database. SQLite file by default (nothing to install).
# For PostgreSQL later: change provider in prisma/schema.prisma and set this URL.
DATABASE_URL=file:./data/coach.db
LEARNER_NAME=me
# Phase 14: set on Azure so only you can use the deployed app (any username, this password)
APP_PASSWORD=
