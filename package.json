{
  "name": "ai-learning-coach",
  "version": "1.0.0",
  "description": "Agentic AI Learning Coach powered by Claude",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run build:web && npm run ingest",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx src/scripts/ingest.ts",
    "mcp": "tsx src/mcp/server.ts",
    "postinstall": "prisma generate",
    "db:setup": "prisma migrate deploy && prisma generate",
    "db:studio": "prisma studio",
    "build:api": "tsc",
    "build:web": "node scripts/build-web.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "prisma": "^7.10.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
